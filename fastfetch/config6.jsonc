{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/dev/doc/json_schema.json",
  "logo": {
    "type": "none",
  },
  "display": {
    "separator": "->   ",
    "color": {
      "separator": "1",
    },
    "constants": ["──────────────────────────────────"],
    "key": {
      "type": "both",
      "paddingLeft": 4,
    },
  },
  "modules": [
    {
      "type": "title",
      "format": "                             {user-name-colored}{at-symbol-colored}{host-name-colored}",
    },
    "break",
    {
      "type": "custom",
      "format": "{$1} \u001b[1;36mSystem Information{#} {$1}",
    },
    "break",
    {
      "type": "custom",
      "format": "    ── \u001b[1;36mHardware{#} ──────────────────────────────────────",
    },
    {
      "key": "CPU          ",
      "keyColor": "yellow",
      "type": "cpu",
    },
    {
      "key": "GPU          ",
      "keyColor": "blue",
      "type": "gpu",
    },
    {
      "key": "Memory       ",
      "keyColor": "magenta",
      "type": "memory",
    },
    {
      "key": "Swap         ",
      "keyColor": "red",
      "type": "swap",
    },
    {
      "key": "Motherboard  ",
      "keyColor": "blue",
      "type": "board",
    },
    {
      "key": "BIOS         ",
      "keyColor": "blue",
      "type": "bios",
    },
    {
      "key": "Chassis      ",
      "keyColor": "green",
      "type": "chassis",
    },
    {
      "key": "Disk         ",
      "keyColor": "yellow",
      "type": "disk",
      "folders": "/",
    },
    {
      "key": "Sound        ",
      "keyColor": "cyan",
      "type": "sound",
    },
    "break",
    {
      "type": "custom",
      "format": "    ── \u001b[1;36mSystem{#} ────────────────────────────────────────",
    },
    {
      "key": "OS           ",
      "keyColor": "red",
      "type": "os",
    },
    {
      "key": "Kernel       ",
      "keyColor": "magenta",
      "type": "kernel",
    },
    {
      "key": "Uptime       ",
      "keyColor": "red",
      "type": "uptime",
    },
    {
      "key": "Login Mgr    ",
      "keyColor": "green",
      "type": "lm",
    },
    {
      "key": "Packages     ",
      "keyColor": "green",
      "type": "packages",
    },
    {
      "key": "Locale       ",
      "keyColor": "cyan",
      "type": "locale",
    },
    "break",
    {
      "type": "custom",
      "format": "    ── \u001b[1;36mDesktop{#} ───────────────────────────────────────",
    },
    {
      "key": "Shell        ",
      "keyColor": "cyan",
      "type": "shell",
    },
    {
      "key": "Terminal     ",
      "keyColor": "red",
      "type": "terminal",
    },
    {
      "key": "Term Font    ",
      "keyColor": "yellow",
      "type": "terminalfont",
    },
    {
      "key": "WM           ",
      "keyColor": "blue",
      "type": "wm",
    },
    {
      "key": "Icon Theme   ",
      "keyColor": "yellow",
      "type": "icons",
    },
    {
      "key": "Font         ",
      "keyColor": "magenta",
      "type": "font",
    },
    {
      "key": "Theme        ",
      "keyColor": "blue",
      "type": "theme",
    },
    {
      "key": "WM Theme     ",
      "keyColor": "cyan",
      "type": "wmtheme",
    },
    {
      "key": "Wallpaper    ",
      "keyColor": "green",
      "type": "wallpaper",
    },
    {
      "key": "Cursor       ",
      "keyColor": "magenta",
      "type": "cursor",
    },
    {
      "key": "Resolution   ",
      "keyColor": "yellow",
      "type": "display",
      "compactType": "original-with-refresh-rate",
    },
    "break",
    {
      "type": "custom",
      "format": "    ── \u001b[1;36mNetwork{#} ───────────────────────────────────────",
    },
    {
      "key": "Local IP     ",
      "keyColor": "red",
      "type": "localip",
      "compact": true,
    },
    {
      "key": "Weather      ",
      "keyColor": "cyan",
      "type": "weather",
      "timeout": 3000,
    },
    {
      "key": "Now Playing  ",
      "keyColor": "green",
      "type": "media",
      "format": "{?artist}{artist} - {?}{title:-40} ",
    },
    {
      "key": "Date/Time    ",
      "keyColor": "magenta",
      "type": "datetime",
    },
    "break",
    {
      "type": "custom",
      "format": "{$1}────────────────────────{$1}",
    },
  ],
}
